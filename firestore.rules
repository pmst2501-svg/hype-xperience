rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile: readable and writable for registered users and live preview sessions
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Events catalog & multimedia
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;

      match /tickets/{ticketId} {
        allow read, write: if true;
      }
    }

    // Root real-time tickets collection (individual QR per ticket)
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // Authorized collaborators collection (scoped QR scanners)
    match /collaborators/{collabId} {
      allow read, write: if true;
    }

    // Default connection test collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
