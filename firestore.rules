rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registered user profiles (Producers, Staff, Buyers)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Registered event producer organizations
    match /organizers/{orgId} {
      allow read, write: if true;
    }

    // Events catalog & multimedia
    match /events/{eventId} {
      allow read, write: if true;

      match /tickets/{ticketId} {
        allow read, write: if true;
      }
    }

    // Root real-time tickets collection (individual QR per ticket)
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // Authorized collaborators / staff collection (scoped QR scanners)
    match /collaborators/{collabId} {
      allow read, write: if true;
    }

    // Stripe checkout orders & payment intents
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // VIP tables & sunbeds
    match /tables/{tableId} {
      allow read, write: if true;
    }

    // Default connection test collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
