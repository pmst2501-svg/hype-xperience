{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with authentication and contact information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth user identifier" },
        "displayName": { "type": "string", "description": "Full name or alias" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "phoneNumber": { "type": "string", "description": "Phone number with country code" },
        "photoURL": { "type": "string", "description": "Profile picture URL or avatar" },
        "role": { "type": "string", "enum": ["admin", "collab", "user"], "description": "Role in Hype Ticket platform" },
        "bio": { "type": "string", "description": "Brief biography or organization details" },
        "company": { "type": "string", "description": "Producer or organizer company name" },
        "isRegistered": { "type": "boolean", "description": "Whether the user completed the mandatory registration gate" },
        "createdAt": { "type": "string", "description": "Account registration timestamp" }
      },
      "required": ["uid", "role"]
    },
    "EventItem": {
      "title": "EventItem",
      "description": "Public and private event records created by organizers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique event ID" },
        "title": { "type": "string", "description": "Name of the event" },
        "code": { "type": "string", "description": "Short code e.g. OLEAJE-ACA-26" },
        "category": { "type": "string", "description": "Event category" },
        "description": { "type": "string", "description": "Detailed event description" },
        "date": { "type": "string", "description": "Event calendar date" },
        "time": { "type": "string", "description": "Event start time" },
        "formattedDateBadge": { "type": "string", "description": "Formatted date and time badge" },
        "venue": { "type": "string", "description": "Venue name (e.g. Oleaje Beach Club)" },
        "address": { "type": "string", "description": "Full street address in Acapulco" },
        "heroImage": { "type": "string", "description": "9:16 vertical cover or landscape banner" },
        "videoStoryUrl": { "type": "string", "description": "9:16 vertical video story URL" },
        "totalCapacity": { "type": "number", "description": "Total attendee capacity" },
        "basePrice": { "type": "number", "description": "Base admission ticket price" },
        "currency": { "type": "string", "description": "Currency code (MXN)" }
      },
      "required": ["id", "title", "date", "venue"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "Event admission ticket with individual QR code payload and real-time check-in trace",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ticket ID" },
        "eventId": { "type": "string", "description": "Related event ID" },
        "folio": { "type": "string", "description": "Ticket folio code" },
        "guestName": { "type": "string", "description": "Attendee full name" },
        "guestEmail": { "type": "string", "format": "email", "description": "Attendee email" },
        "guestPhone": { "type": "string", "description": "Attendee phone number" },
        "buyerUid": { "type": "string", "description": "UID of the buyer profile" },
        "tier": { "type": "string", "enum": ["General", "VIP", "Backstage", "Mesa VIP"], "description": "Ticket tier" },
        "price": { "type": "number", "description": "Price paid" },
        "status": { "type": "string", "enum": ["valid", "used", "cancelled"], "description": "Current status" },
        "qrPayload": { "type": "string", "description": "Individual encrypted QR code verification payload" },
        "issuedAt": { "type": "string", "description": "Purchase timestamp" },
        "usedAt": { "type": "string", "description": "Timestamp when checked in at entrance" },
        "checkedInByCollabId": { "type": "string", "description": "Collaborator ID who scanned the QR" },
        "checkedInByName": { "type": "string", "description": "Collaborator name who scanned the QR" },
        "checkedInGate": { "type": "string", "description": "Entrance gate where QR was scanned" }
      },
      "required": ["id", "eventId", "folio", "guestName", "tier", "status", "qrPayload"]
    },
    "Collaborator": {
      "title": "Collaborator",
      "description": "Authorized collaborator allowed to scan ticket QR codes in real time",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Collaborator ID" },
        "name": { "type": "string", "description": "Full name" },
        "roleTitle": { "type": "string", "description": "Assigned role at the venue" },
        "email": { "type": "string", "format": "email", "description": "Authorized email address" },
        "phone": { "type": "string", "description": "Authorized phone number" },
        "pin": { "type": "string", "description": "4-digit access PIN" },
        "status": { "type": "string", "enum": ["active", "inactive"], "description": "Authorization status" },
        "checkinsCount": { "type": "number", "description": "Total QR check-ins registered" },
        "assignedGate": { "type": "string", "description": "Assigned venue gate" },
        "avatar": { "type": "string", "description": "Collaborator avatar URL" },
        "lastActive": { "type": "string", "description": "Last scan timestamp" }
      },
      "required": ["id", "name", "email", "status", "assignedGate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles for registered attendees, collaborators, and creators"
    },
    "/events/{eventId}": {
      "schema": "EventItem",
      "description": "Event catalog and multimedia configuration"
    },
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Issued tickets with individual QR codes and real-time scan status"
    },
    "/collaborators/{collabId}": {
      "schema": "Collaborator",
      "description": "Authorized collaborators added by creators via email or phone"
    }
  }
}
